# Everything here is optional. The stack runs with no .env file at all.
# Copy to .env only if you need to change a default.

# Replay sessions already on disk at startup, instead of only following new ones.
BACKFILL=false

# Where the CLI keeps its session event logs. Defaults to ~/.copilot/session-state
# on macOS, Linux and Windows. Set this only if yours lives somewhere else.
#   macOS / Linux:  COPILOT_STATE_DIR=/home/you/.copilot/session-state
#   Windows:        COPILOT_STATE_DIR=C:\Users\you\.copilot\session-state
# COPILOT_STATE_DIR=
